<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sist.mapper.food-mapper">
<!--  맛집 목록 출력 -->
<select id="foodListData" resultType="FoodVO" parameterType="int"> 

  <!--  1. id  => 구분자라서 중복되면 절대 안 됨, 대소문자 구분해줘야해!
                  FoodDAO에 foodListData()라는 메소드를 만들었으니 여기 아이디에도 L은 대분자롤 써야했어
        2. resultType => 값을 저장하는 데이터
        3. parameterTyp => ?에 값 설정하는 데이터
        4. resulMap => 원하는 방식으로 값을 채운다  
        
  ======================================================    
   주석 추가하기  
        -->
  <!--  1. mapper.xml에서 파싱 시작 => 즉, 필요한 데이터를 읽을 거야 
  
          #{start}
          => 이 안에 들어가는 값이 int냐 String이냐에 따라 파라미터 타입의 설정이 달라진다
          
          -->
   SELECT no,poster,name,address
   FROM food
   ORDER BY no ASC
   OFFSET #{start} ROWS FETCH NEXT 12 ROWS ONLY      
</select>
 <!--  총페이지 구하기 -->
 <select id="foodTotalPage" resultType="int">
  SELECT CEIL(COUNT(*)/12.0) FROM food
 </select>
 <!--  상세보기  -->
 <select id="foodDetailData" resultType="FoodVO" parameterType="int">
  SELECT *
  FROM food
  WHERE no=#{no}
 </select>
</mapper>
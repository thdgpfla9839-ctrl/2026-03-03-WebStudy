<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-config.dtd">
<!-- 커넥션과 관련된 파일, 환경설정?

이번에는 food 안에서 댓글 + 지도 삽입 해볼 것
       goods 안에서 장바구니 + 결제창 띄우기
       => Ajax(자체처리)를 이용할 거 같음
=========================================
Config.xml은 1개만 설정이 된다
mapper.xml은 테이블 당 1개씩 설정한다 => 어노테이션 / xml 두가지로 만들 수 있다
=================================================================
   1. 동작 순서 :
   
      1) 사용자 요청
      2) Controller가 요청을 받는다
      3) Model에 있는 메소드를 호출한다 => @RequestMapping을 이용했어
         -> 메소드가 호출 됐을 때
                 |
                 데이터베이스 연동
                 |
                 getConnenction() : Config.xml
                 disConnection()
                => SqlSession이 담당 
                 |
                 mapper.xml => SqlSession이 담담
                 |
                 sql 문장을 읽어서 실행 후
                 ResultSet응 이용해서 List / VO에 담아주는 역할      
=================================================================

1. 연결
======================================= => SqlSessionFactory(=Connection)
2. sql 문장 읽기       
3. sql 문장을 전송       
4. sql 문장을 실행 요청
5. 결과값을 받는다
=================== => SqlSession(Preparedstatement,ResultSet)이 담당       
6. 닫기
 -->
 
<configuration>

<!--  properties 파일 읽기 -->
<properties resource="db.properties"/>

  <!-- VO 등록 -->
  <typeAliases>
   <typeAlias type="com.sist.vo.FoodVO" alias="FoodVO"/>
   <typeAlias type="com.sist.vo.ReplyVO" alias="ReplyVO"/>
   <typeAlias type="com.sist.vo.MemberVO" alias="MemberVO"/>
  </typeAliases>
  
  <!-- 데이터베이스 설정 -->
  <environments default="development">
   <environment id="development">
   
   <!-- transaction : JDBC / MANAGE -->
     <transactionManager type="JDBC"/>
     
     <!-- 정보 설정 (보안 유지가 뛰어남) -->
     <dataSource type="POOLED">
     
     <!-- POOLED(ConnectionPool) / UNPOOLED(일반 JDBC)  -->
      <property name="driver" value="${driver}"/>
      <property name="url" value="${url}"/>
      <property name="username" value="${username}"/>
      <property name="password" value="${password}"/>
      
     </dataSource>
   </environment>
  </environments>
  <!-- SQL문장 : mapper 등록 -->
  <mappers>
   <mapper resource="com/sist/mapper/food-mapper.xml"/>
   <!-- include 
        <!ENTITY nbsp ""> &nbsp;
        <!ENTITY lt "<">  &lt;
        <!ENTITY gt ">">  &gt;
        <!ENTITY xml "파일명"> &xml;
        XML 단점 커길수록 속도가 느려진다 (스트럿츠)
   
   -->
  </mappers>
</configuration>
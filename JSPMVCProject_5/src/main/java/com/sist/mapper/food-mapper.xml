<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sist.mapper.food-mapper">
<!-- sql문 저장하는 곳 -->
<!-- 
    파싱 => 저장(Map)
    id : key로 사용
    resultType : 결과값을 담을 데이터형 선택
    parameterType : ?에 값을 채우는 데이터형
    resultMap : VO가 여러개 혼합일 시 처리 => JOIN

 -->
 
 <!--  
        <sql> : 중복 sql문장을 모아두는 태그 => 필요시 마다 <include>를 이용해서 작성
        <select> : 데이터 검색
        <insert> : 데이터추가 => 유일하게 2개 사용이 가능 : sequence
        <update>
        <delete>
        => 각 태그에는 sql 문장 1개만 사용이 가능하다
           만약 2개 이상이 필요하다면 '서브쿼리'를 이용
 
 
 
  -->
 
 <!-- 중복되는 sql 문장 위에 불러 놓고 밑에 중복되는 부분 제거라고 대체해서 사용한다 -->
 <sql id="select">
  SELECT no,name,poster,address
  FROM food
 </sql>
 <sql id="offset">
  OFFSET #{start} ROWS FETCH NEXT 12 ROWS ONLY  
 </sql>
 
 <select id="foodListData" resultType="FoodVO" parameterType="int">
  <include refid="select" />
  ORDER BY no ASC
   <include refid="offset"/> 
 </select> 
 
 <!-- 
     resultType : 리턴형
     parameterType : 매개변수
     public FoodVO
     
 
  -->
  
 <select id="foodDetailData" resultType="FoodVO" parameterType="int">
  SELECT *
  FROM food
  WHERE no=#{no}
 </select>
 
 <!-- 
 
    데이터가 여러개인 경우(?가 여러개일 때)
    :
      1) hashmap : vo에 없는 변수인 경우
                   예) start / fd / column => vo에 존재하지 않으니 hashmap에 저장
      2) FoodVO
 
  -->
 
 <select id="foodFindData" resultType="FoodVO" parameterType="hashmap">
   <include refid="select" />
    WHERE ${column} LIKE '%'||#{fd}||'%'
   <include refid="offset"/> 
 </select>
 
 <sql id="total">
  SELECT CEIL(COUNT(*)/12.0) FROM food
 </sql>
 
  <select id="foodTotalPage" resultType="int">
    <include refid="total"/>
  </select>
  
    <select id="foodFindTotalPage" resultType="int" parameterType="hashmap">
      <include refid="total"/>        
       WHERE ${column} LIKE '%'||#{fd}||'%'       
    </select> 
    
 </mapper>